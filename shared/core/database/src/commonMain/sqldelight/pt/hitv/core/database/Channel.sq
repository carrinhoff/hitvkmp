-- Channel table for live TV channels
CREATE TABLE Channel (
    channelId INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    streamUrl TEXT NOT NULL,
    streamIcon TEXT NOT NULL,
    epgChannelId TEXT,
    categoryCreatorId TEXT NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    licenseKey TEXT,
    userId INTEGER NOT NULL,
    lastViewedTimestamp INTEGER NOT NULL DEFAULT 0,
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    lastSeen INTEGER NOT NULL DEFAULT 0,
    contentHash TEXT,
    syncVersion INTEGER NOT NULL DEFAULT 1,
    tvArchive INTEGER NOT NULL DEFAULT 0,
    tvArchiveDuration INTEGER NOT NULL DEFAULT 0,
    catchupType TEXT,
    catchupSource TEXT
);

CREATE UNIQUE INDEX channel_unique ON Channel(name, streamIcon, categoryCreatorId, userId);

-- ==================== Queries ====================

-- Get all channels for a user (non-paged)
selectAllByUserId:
SELECT * FROM Channel WHERE userId = ? ORDER BY name ASC;

-- Get all channels paged
selectAllPaged:
SELECT * FROM Channel WHERE userId = ? ORDER BY name ASC LIMIT ? OFFSET ?;

-- Get channels by category paged
selectByCategoryPaged:
SELECT * FROM Channel WHERE userId = ? AND categoryCreatorId = ? ORDER BY name ASC LIMIT ? OFFSET ?;

-- Get favorite channels paged
selectFavoritesPaged:
SELECT * FROM Channel WHERE userId = ? AND isFavorite = 1 ORDER BY name ASC LIMIT ? OFFSET ?;

-- Get catch-up enabled channels paged
selectCatchUpPaged:
SELECT * FROM Channel WHERE userId = ? AND tvArchive = 1 ORDER BY name ASC LIMIT ? OFFSET ?;

-- Count catch-up channels
countCatchUpByUserId:
SELECT COUNT(*) FROM Channel WHERE userId = ? AND tvArchive = 1;

-- Get recently viewed channels
selectRecentlyViewed:
SELECT * FROM Channel WHERE userId = ? AND lastViewedTimestamp IS NOT NULL AND lastViewedTimestamp != 0 ORDER BY lastViewedTimestamp DESC LIMIT 10;

-- Get recently viewed channels paged
selectRecentlyViewedPaged:
SELECT * FROM Channel WHERE userId = ? AND lastViewedTimestamp IS NOT NULL AND lastViewedTimestamp != 0 ORDER BY lastViewedTimestamp DESC LIMIT ? OFFSET ?;

-- Search channels by name (case-insensitive)
searchByName:
SELECT * FROM Channel WHERE userId = ? AND LOWER(name) LIKE LOWER(?) ORDER BY name ASC LIMIT ? OFFSET ?;

-- Flexible multi-word channel search: every word must appear in the name, in ANY order.
--
-- Ports `SearchUtils.createFlexibleSearchQuery` + `DAOChannel.searchChannelsFlexible` from the
-- original, which emits one `LOWER(name) LIKE ?` per word and ANDs them together through Room's
-- @RawQuery. The port had collapsed that to a single ordered pattern, `%word1%word2%`, which
-- requires the words to appear in the typed order: searching "sports hd" then missed a channel
-- named "HD Sports". Multi-word channel names are the norm in IPTV playlists, so this bit often.
--
-- SQLDelight has no dynamic SQL, so the word list is spread over a fixed number of slots and
-- unused slots are passed as '' — the `= ''` guard makes them no-ops. That is the same shape
-- already used by `selectByCategorySorted`. Keep the slot count in step with
-- `SearchUtils.FLEXIBLE_SEARCH_SLOTS`; `SearchUtilsTest` pins the two together.
--
-- Patterns arrive pre-lowercased and pre-wrapped ('%word%') from `SearchUtils.flexibleLikeSlots`,
-- matching the original, which lowercases each word itself and only ever LOWER()s the column.
searchByNameFlexible:
SELECT * FROM Channel
WHERE userId = :userId
  AND (:w1 = '' OR LOWER(name) LIKE :w1)
  AND (:w2 = '' OR LOWER(name) LIKE :w2)
  AND (:w3 = '' OR LOWER(name) LIKE :w3)
  AND (:w4 = '' OR LOWER(name) LIKE :w4)
  AND (:w5 = '' OR LOWER(name) LIKE :w5)
  AND (:w6 = '' OR LOWER(name) LIKE :w6)
ORDER BY name ASC
LIMIT :limit OFFSET :offset;

-- Same flexible search, across EVERY account rather than one.
--
-- Used by the "add channels to a custom group" picker. The original's
-- `CustomGroupRepositoryImpl.searchAllChannelsFlexible` builds its WHERE clause from the words
-- alone and deliberately omits any userId predicate, so the picker can pull channels from all
-- stored accounts. The port called the single-user `searchByName` with a hardcoded userId of 0
-- under a comment claiming it searched all users -- and since `UserCredentials.userId` is
-- INTEGER PRIMARY KEY AUTOINCREMENT, SQLite hands out 1 for the first account and never 0. The
-- predicate therefore matched no row on any install and the picker's search was dead.
searchAllByNameFlexible:
SELECT * FROM Channel
WHERE (:w1 = '' OR LOWER(name) LIKE :w1)
  AND (:w2 = '' OR LOWER(name) LIKE :w2)
  AND (:w3 = '' OR LOWER(name) LIKE :w3)
  AND (:w4 = '' OR LOWER(name) LIKE :w4)
  AND (:w5 = '' OR LOWER(name) LIKE :w5)
  AND (:w6 = '' OR LOWER(name) LIKE :w6)
ORDER BY name ASC
LIMIT :limit OFFSET :offset;

-- Get a single channel by name and userId
selectByName:
SELECT * FROM Channel WHERE name = ? AND userId = ? LIMIT 1;

-- User-owned channel state that a content sync must not destroy.
--
-- `insertOrReplace` (used by syncChannels) hardcodes isFavorite = 0 and
-- lastViewedTimestamp = 0, so a re-sync silently wiped every favourite and the whole
-- recently-viewed list. SQLite 3.19 (minSdk 26) predates UPSERT's ON CONFLICT DO UPDATE,
-- so the fix is snapshot-before / restore-after around the sync transaction.
--
-- Deliberately narrow: only rows the user has actually touched, so the snapshot stays small
-- even on a 50k-channel account.
selectUserStateForSync:
SELECT name, categoryCreatorId, isFavorite, lastViewedTimestamp
FROM Channel
WHERE userId = ? AND (isFavorite = 1 OR lastViewedTimestamp != 0);

-- Re-applies one snapshot row. Keyed the same way updateFavorite is.
restoreUserStateForSync:
UPDATE Channel SET isFavorite = ?, lastViewedTimestamp = ?
WHERE name = ? AND userId = ? AND categoryCreatorId = ?;

-- Get a channel by EPG ID
selectByEpgId:
SELECT * FROM Channel WHERE LOWER(TRIM(epgChannelId)) = LOWER(TRIM(?)) AND userId = ? LIMIT 1;

-- All distinct EPG channel ids this user actually subscribes to, normalized the same way
-- selectByEpgId matches them. Used as the XMLTV parse allowlist so a public feed carrying
-- thousands of foreign channels doesn't get parsed and inserted wholesale — see the
-- channelFilter parameter on EpgParser.parse and the original's XmltvParser channelFilter.
selectEpgChannelIdsForUser:
SELECT DISTINCT LOWER(TRIM(epgChannelId)) AS epgId
FROM Channel
WHERE userId = ? AND epgChannelId IS NOT NULL AND TRIM(epgChannelId) != '';

-- Get favorite status
selectFavoriteStatus:
SELECT isFavorite FROM Channel WHERE name = ? AND categoryCreatorId = ? AND userId = ? LIMIT 1;

-- Find existing channel for sync
findExistingChannel:
SELECT * FROM Channel WHERE userId = ? AND name = ? AND categoryCreatorId = ? LIMIT 1;

-- Get all channels for sync
selectAllForSync:
SELECT * FROM Channel WHERE userId = ?;

-- Count queries
countByUserId:
SELECT COUNT(*) FROM Channel WHERE userId = ?;

countByCategoryAndUserId:
SELECT COUNT(*) FROM Channel WHERE userId = ? AND categoryCreatorId = ?;

countRecentChannels:
SELECT COUNT(*) FROM Channel WHERE userId = ? AND lastSeen >= ?;

-- Get channels limited
selectAllLimited:
SELECT * FROM Channel WHERE userId = ? ORDER BY name ASC LIMIT ?;

selectByCategoryLimited:
SELECT * FROM Channel WHERE userId = ? AND categoryCreatorId = ? ORDER BY name ASC LIMIT ?;

-- ==================== Mutations ====================

-- Insert or replace a channel
insertOrReplace:
INSERT OR REPLACE INTO Channel(name, streamUrl, streamIcon, epgChannelId, categoryCreatorId, isFavorite, licenseKey, userId, lastViewedTimestamp, lastUpdated, lastSeen, contentHash, syncVersion, tvArchive, tvArchiveDuration, catchupType, catchupSource)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Insert or ignore a channel (returns rowid)
insertOrIgnore:
INSERT OR IGNORE INTO Channel(name, streamUrl, streamIcon, epgChannelId, categoryCreatorId, isFavorite, licenseKey, userId, lastViewedTimestamp, lastUpdated, lastSeen, contentHash, syncVersion, tvArchive, tvArchiveDuration, catchupType, catchupSource)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update favorite status
updateFavorite:
UPDATE Channel SET isFavorite = ? WHERE name = ? AND userId = ? AND categoryCreatorId = ?;

-- Update recently viewed timestamp
updateLastViewedTimestamp:
UPDATE Channel SET lastViewedTimestamp = ? WHERE name = ? AND userId = ? AND categoryCreatorId = ?;

-- Update channel (full update by id)
-- catchupType / catchupSource are included so this matches the full column set that
-- `EntityChannel.fromWithExistingSync` writes in the original. They were missing, so a provider
-- that started or stopped offering catch-up on an existing channel would never have that reflected
-- once differential sync began using UPDATE instead of INSERT OR REPLACE.
updateById:
UPDATE Channel SET name = ?, streamUrl = ?, streamIcon = ?, epgChannelId = ?, categoryCreatorId = ?, isFavorite = ?, licenseKey = ?, lastViewedTimestamp = ?, lastUpdated = ?, lastSeen = ?, contentHash = ?, syncVersion = ?, tvArchive = ?, tvArchiveDuration = ?, catchupType = ?, catchupSource = ?
WHERE channelId = ?;

-- Mark channels as seen
markAsSeen:
UPDATE Channel SET lastSeen = ? WHERE userId = ? AND channelId IN ?;

-- Delete channels by userId
deleteByUserId:
DELETE FROM Channel WHERE userId = ?;

-- Delete stale channels
deleteStale:
DELETE FROM Channel WHERE userId = ? AND lastSeen < ?;

-- Counterpart to deleteStale, so a differential sync can report how many rows it removed.
-- SQLDelight does not surface an affected-row count from DELETE the way Room's @Query Int return
-- does, which is what the original uses for DifferentialSyncResult.deleted.
countStale:
SELECT COUNT(*) FROM Channel WHERE userId = ? AND lastSeen < ?;
